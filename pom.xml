<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.health.capstone</groupId>
    <artifactId>wipro-capstone-project</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Healthcare Wellness System - Parent</name>
    <description>Parent POM for all microservices</description>

    <!-- ========== GLOBAL PROPERTIES ========== -->
    <properties>
        <!-- set Java release used for compilation across modules -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- centralize Lombok version to ensure consistent annotation-processor -->
        <lombok.version>1.18.40</lombok.version>

        <!-- encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- ========== DEPENDENCY MANAGEMENT (centralize versions) ========== -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.40</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <!-- ========== PLUGIN MANAGEMENT ========== -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Compiler plugin: ensure all modules compile with release 17 and receive Lombok as annotation-processor -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <!-- use release to match JDK 17 precisely -->
                        <release>${maven.compiler.release}</release>

                        <!-- ensure Lombok is available to the annotation processor for all modules -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- Optional: provide a shared spring-boot-maven-plugin config if you want -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <modules>
        <module>auth-service/auth-service</module>
        <module>backend1/appointment-Service</module>
        <module>backend1/Patient-Service</module>
        <module>backend1/Provider-Service</module>
        <module>backend1/Enrollment-Service</module>
        <module>backend1/Payment-Service</module>
        <module>backend1/Wellness-Service</module>
    </modules>

</project>
